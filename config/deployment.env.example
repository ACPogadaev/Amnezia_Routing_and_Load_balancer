# Copy this file to config/deployment.env and replace every CHANGE_ME value.
# The parser does not execute shell syntax: use plain KEY=value lines.

# Existing Amnezia ingress on the balancer.
BALANCER_PUBLIC_IP=CHANGE_ME_BALANCER_PUBLIC_IPV4
PUBLIC_IF=eth0
INGRESS_CONTAINER=amnezia-awg2
INGRESS_AWG_IF=awg0
INGRESS_CLIENT_SUBNET=10.8.1.0/24
VERIFY_CLIENT_IP=10.8.1.2
INGRESS_AWG_PORT=CHANGE_ME_INGRESS_UDP_PORT

# Existing Docker networks used by the ingress container. Obtain these values
# with the discovery commands from docs/CONFIGURATION.md.
INGRESS_OUTER_NETWORK=amnezia-dns-net
INGRESS_OUTER_BRIDGE=amn0
INGRESS_OUTER_IP=CHANGE_ME_INGRESS_OUTER_IPV4
INGRESS_OUTER_GATEWAY=CHANGE_ME_INGRESS_OUTER_GATEWAY
INGRESS_DNS_NETWORK=amnezia-dns-net
INGRESS_DNS_BRIDGE=amn0
INGRESS_DNS_IP=CHANGE_ME_INGRESS_DNS_IPV4
INGRESS_DNS_GATEWAY=CHANGE_ME_INGRESS_DNS_GATEWAY
INGRESS_AUX_NETWORK=bridge
INGRESS_AUX_BRIDGE=docker0
INGRESS_AUX_IP=CHANGE_ME_INGRESS_AUX_IPV4

# Reachability probe. Choose a public server you control or are authorized to
# probe. It must be outside the routed target list.
HEALTH_TARGET_IP=CHANGE_ME_HEALTH_TARGET_IPV4
HEALTH_TARGET_TCP_PORT=443
ACTIVE_TEST_IP=CHANGE_ME_IP_FROM_YOUR_ROUTE_LIST

# First egress AmneziaWG client profile.
MAIN_AWG_IP=CHANGE_ME_MAIN_AWG_CLIENT_IPV4
MAIN_ENDPOINT_IP=CHANGE_ME_MAIN_AWG_ENDPOINT_IPV4
MAIN_ENDPOINT_PORT=CHANGE_ME_MAIN_AWG_ENDPOINT_UDP_PORT
MAIN_EXPECTED_EXIT_IP=CHANGE_ME_MAIN_PUBLIC_EXIT_IPV4

# Second egress AmneziaWG client profile.
EGRESS2_AWG_IP=CHANGE_ME_EGRESS2_AWG_CLIENT_IPV4
EGRESS2_ENDPOINT_IP=CHANGE_ME_EGRESS2_AWG_ENDPOINT_IPV4
EGRESS2_ENDPOINT_PORT=CHANGE_ME_EGRESS2_AWG_ENDPOINT_UDP_PORT
EGRESS2_EXPECTED_EXIT_IP=CHANGE_ME_EGRESS2_PUBLIC_EXIT_IPV4

# Third egress AmneziaWG client profile.
EGRESS3_AWG_IP=CHANGE_ME_EGRESS3_AWG_CLIENT_IPV4
EGRESS3_ENDPOINT_IP=CHANGE_ME_EGRESS3_AWG_ENDPOINT_IPV4
EGRESS3_ENDPOINT_PORT=CHANGE_ME_EGRESS3_AWG_ENDPOINT_UDP_PORT
EGRESS3_EXPECTED_EXIT_IP=CHANGE_ME_EGRESS3_PUBLIC_EXIT_IPV4

# Controller tuning. Defaults detect a failed exit after roughly 20-30 s and
# require three successful probes before recovery.
HEALTH_URL=https://1.1.1.1/cdn-cgi/trace
HEALTH_URL_SECONDARY=https://api.ipify.org
HEALTH_INTERVAL_SECONDS=10
HEALTH_TIMEOUT_SECONDS=6
HEALTH_FAILURE_THRESHOLD=3
HEALTH_SUCCESS_THRESHOLD=3
HEALTH_MAX_HANDSHAKE_AGE_SECONDS=300
LOAD_EWMA_ALPHA=0.35
LOAD_REFERENCE_BPS=1048576
LOAD_WEIGHT_FLOOR=0.25
