[Unit]
Description=Amnezia LB v3 additional egress containers
Wants=docker.service
Requires=amnezia-lb-multi-v3-guard.service amnezia-lb-v2-pilot.service
After=docker.service amnezia-lb-multi-v3-guard.service amnezia-lb-v2-pilot.service

[Service]
Type=oneshot
Environment=AMNEZIA_LB_MULTI_DIR=/etc/amnezia-lb-multi-v3
ExecStart=/etc/amnezia-lb-multi-v3/host/egress-up.sh
ExecStop=/etc/amnezia-lb-multi-v3/host/egress-down.sh
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
