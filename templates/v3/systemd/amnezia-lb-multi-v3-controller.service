[Unit]
Description=Amnezia LB v4 health, quarantine and egress recovery controller
Wants=docker.service amnezia-lb-v2-pilot.service amnezia-lb-multi-v3-egress.service
Requires=amnezia-lb-multi-v3-guard.service
After=docker.service amnezia-lb-multi-v3-guard.service amnezia-lb-v2-pilot.service amnezia-lb-multi-v3-egress.service

[Service]
Type=simple
Environment=AMNEZIA_LB_MULTI_DIR=/etc/amnezia-lb-multi-v3
ExecStart=/etc/amnezia-lb-multi-v3/host/controller.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
