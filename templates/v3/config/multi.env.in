# Generated file. Internal bridges/subnets are fixed by this implementation.
V2_DIR=/etc/amnezia-lb-v2
RUNTIME_DIR=/run/amnezia-lb-multi-v3
RELEASE_ID=amnezia-lb-v4-recovery
STATE_ROOT=/var/lib/amnezia-lb
LOCK_FILE=/var/lib/amnezia-lb/state.lock
MAINTENANCE_FILE=/var/lib/amnezia-lb/maintenance
MODE_FILE=/var/lib/amnezia-lb/mode

INGRESS_CONTAINER=@@INGRESS_CONTAINER@@
INGRESS_TRANSIT_BRIDGE=amlt0
INGRESS_TRANSIT_IP=172.30.250.10
PUBLIC_IF=@@PUBLIC_IF@@

PGDL_NETWORK=amnezia-lb-egress2-stage
PGDL_BRIDGE=amlp0
PGDL_SUBNET=172.30.251.0/24
PGDL_GATEWAY=172.30.251.1
PGDL_CONTAINER=amnezia-egress-2-v3
PGDL_CONTAINER_IP=172.30.251.11
PGDL_AWG_IF=awg-egress2
PGDL_AWG_IP=@@EGRESS2_AWG_IP@@
PGDL_ENDPOINT_IP=@@EGRESS2_ENDPOINT_IP@@
PGDL_ENDPOINT_PORT=@@EGRESS2_ENDPOINT_PORT@@
PGDL_POLICY_TABLE=202

AE_NETWORK=amnezia-lb-egress3-stage
AE_BRIDGE=amla0
AE_SUBNET=172.30.252.0/24
AE_GATEWAY=172.30.252.1
AE_CONTAINER=amnezia-egress-3-v3
AE_CONTAINER_IP=172.30.252.11
AE_AWG_IF=awg-egress3
AE_AWG_IP=@@EGRESS3_AWG_IP@@
AE_ENDPOINT_IP=@@EGRESS3_ENDPOINT_IP@@
AE_ENDPOINT_PORT=@@EGRESS3_ENDPOINT_PORT@@
AE_POLICY_TABLE=203

MAIN_AWG_IP=@@MAIN_AWG_IP@@
MAIN_EXPECTED_EXIT_IP=@@MAIN_EXPECTED_EXIT_IP@@
PGDL_EXPECTED_EXIT_IP=@@EGRESS2_EXPECTED_EXIT_IP@@
AE_EXPECTED_EXIT_IP=@@EGRESS3_EXPECTED_EXIT_IP@@
HOST_MAIN_TABLE=401
HOST_PGDL_TABLE=402
HOST_AE_TABLE=403
MAIN_MARK=0x201
PGDL_MARK=0x202
AE_MARK=0x203
# Marks removed from egresses.json must be listed here during a migration so
# old conntrack entries remain quarantined. It is empty for a fresh 3-egress
# installation.
RETIRED_MARKS=
FAIL_MARK=0x2ff

HEALTH_URL=@@HEALTH_URL@@
HEALTH_URL_SECONDARY=@@HEALTH_URL_SECONDARY@@
TARGET_IP=@@HEALTH_TARGET_IP@@
TARGET_TCP_PORT=@@HEALTH_TARGET_TCP_PORT@@
HEALTH_INTERVAL_SECONDS=@@HEALTH_INTERVAL_SECONDS@@
HEALTH_TIMEOUT_SECONDS=@@HEALTH_TIMEOUT_SECONDS@@
HEALTH_FAILURE_THRESHOLD=@@HEALTH_FAILURE_THRESHOLD@@
HEALTH_SUCCESS_THRESHOLD=@@HEALTH_SUCCESS_THRESHOLD@@
HEALTH_MAX_HANDSHAKE_AGE_SECONDS=@@HEALTH_MAX_HANDSHAKE_AGE_SECONDS@@
HEALTH_PROBE_TIMEOUT_SECONDS=@@HEALTH_PROBE_TIMEOUT_SECONDS@@
HEALTH_CONNECT_TIMEOUT_SECONDS=@@HEALTH_CONNECT_TIMEOUT_SECONDS@@
HEALTH_HTTP_TIMEOUT_SECONDS=@@HEALTH_HTTP_TIMEOUT_SECONDS@@
HEALTH_CONFIG_GENERATION=@@HEALTH_CONFIG_GENERATION@@
HEALTH_MAX_SAMPLE_AGE_SECONDS=@@HEALTH_MAX_SAMPLE_AGE_SECONDS@@
ALLOW_LEGACY_PROBE=@@ALLOW_LEGACY_PROBE@@
LOAD_EWMA_ALPHA=@@LOAD_EWMA_ALPHA@@
LOAD_REFERENCE_BPS=@@LOAD_REFERENCE_BPS@@
LOAD_WEIGHT_FLOOR=@@LOAD_WEIGHT_FLOOR@@

# Lifecycle recovery. The build defaults to disabled. Enable one named egress
# at a time after validating monitoring and rollback.
RECOVERY_ENABLED=@@RECOVERY_ENABLED@@
RECOVERY_ALLOWED_EGRESSES=@@RECOVERY_ALLOWED_EGRESSES@@
RECOVERY_ALLOW_CRASHLOOP_CONTAINMENT=@@RECOVERY_ALLOW_CRASHLOOP_CONTAINMENT@@
RECOVERY_FAILURE_THRESHOLD=@@RECOVERY_FAILURE_THRESHOLD@@
RECOVERY_COOLDOWN_SECONDS=@@RECOVERY_COOLDOWN_SECONDS@@
RECOVERY_WINDOW_SECONDS=@@RECOVERY_WINDOW_SECONDS@@
RECOVERY_MAX_RESTARTS=@@RECOVERY_MAX_RESTARTS@@
RECOVERY_MAX_PARALLEL=@@RECOVERY_MAX_PARALLEL@@
RECOVERY_STARTUP_GRACE_SECONDS=@@RECOVERY_STARTUP_GRACE_SECONDS@@
RECOVERY_STATE_FILE=/var/lib/amnezia-lb/recovery-state.json
RECOVERY_LOCK_FILE=/var/lib/amnezia-lb/recovery.lock
DRAIN_DIR=/var/lib/amnezia-lb/drain
