    "mark": 514,
    "compose_project": "egress",
    "compose_service": "egress-pgdl",
    "compose_file": "/etc/amnezia-lb-multi-v3/egress/compose.yaml",
    "ready_file": "/run/amnezia-lb-multi-v3/egress-policy-ready",
    "forward_helper": "/etc/amnezia-lb-multi-v3/host/egress-forward-enable.sh"
  },
  {
    "name": "ae",
    "container": "amnezia-egress-3-v3",
