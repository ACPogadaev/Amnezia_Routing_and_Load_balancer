[
  {
    "name": "main",
    "container": "amnezia-egress-main-pilot-v2",
    "awg_if": "awg-main",
    "awg_ip": "@@MAIN_AWG_IP@@",
    "expected_exit_ip": "@@MAIN_EXPECTED_EXIT_IP@@",
    "mark": 513,
    "compose_project": "egress",
    "compose_service": "egress-main",
    "compose_file": "/etc/amnezia-lb-v2/egress/compose.yaml",
    "ready_file": "/run/amnezia-lb-v2/egress-policy-ready",
    "forward_helper": "/etc/amnezia-lb-v2/host/egress-forward-enable.sh"
  },
  {
    "name": "pgdl",
    "container": "amnezia-egress-2-v3",
